[Unit]
Description=TXF Streaming Producer (Shioaji -> Kafka)
Documentation=https://github.com/gman-quant/txf-streaming-server
After=network-online.target kafka.service
Requires=kafka.service
PartOf=kafka.service

# 崩潰迴圈保護:10 分鐘內失敗 5 次就停止嘗試。
# ⚠️ 2026-07-21 修正:原本是 60s/5 次,但 RestartSec=25s 表示 60 秒內最多只重啟 2 次,
#    永遠碰不到 5 次門檻 → 那道保險等於失效,真遇到 crash loop 會無限重啟。
#    改成 600s 後,5 次門檻才真的可能觸發。
StartLimitIntervalSec=600s
StartLimitBurst=5

[Service]
# --- 執行權限與路徑 ---
User=shioaji_svc
Group=shioaji_svc
WorkingDirectory=/home/shioaji_svc/txf-streaming-server
ExecStart=/home/shioaji_svc/txf-streaming-server/.venv/bin/python -u -m src.txf_producer

# --- 效能與優先權優化 ---
# 提高 CPU 權重，降低延遲抖動
Nice=-10
# 提高 OOM 存活率 (值越低越不容易被系統砍掉)
OOMScoreAdjust=-500
# 增加可開啟的檔案/Socket 數量
LimitNOFILE=65536

# 🚀 獨佔 CPU 核心 (CPUAffinity)
# 把程式鎖在固定核心,避免核心切換造成 CPU 快取失效與抖動。
# ⚠️ 2026-07-21 修正:原本只綁 `2`,但本機 i7-4770 是 4 實體核 + HT = 8 邏輯核,
#    **邏輯核 2 與 6 是同一顆實體核的 HT 兄弟**(/sys/.../cpu2/topology/thread_siblings_list = 2,6),
#    共用執行單元與 L1/L2。只綁 2 的話,任何排到 6 的工作仍會與本程式搶同一顆實體核。
#    兩個都綁才是真正獨佔一顆實體核。
# 📌 換機器務必重新確認:`cat /sys/devices/system/cpu/cpu<N>/topology/thread_siblings_list`
CPUAffinity=2 6

# --- 預檢機制 ---
# 等待 Kafka Port 就緒
ExecStartPre=/bin/bash -c 'until echo > /dev/tcp/localhost/9092; do sleep 1; done'

# --- 重啟策略 ---
# ⚠️ 2026-07-21 改 `on-failure` → `always`(2026-07-25 依實際碼修正本註解)。
#    事實:producer 的**所有錯誤路徑都是 sys.exit(1)**,碼裡沒有 sys.exit(0);
#    exit 0 只發生在「收到 SIGTERM/SIGINT → stop_event → 乾淨關閉」。
#    → 所以 on-failure 其實已涵蓋所有現實的崩潰模式,always 多接住的只有一種:
#      **有東西送了 SIGTERM 但不是透過 systemctl stop**(手滑 kill、清理腳本、session 掃除)。
#      那種情況 exit 0、不算 failure,on-failure 會讓它靜靜躺到下次 crontab 啟動,
#      中間行情全丟。機率低但屬靜默資料遺失,always 是便宜的保險。
#    ✅ 不影響 crontab:`systemctl stop` 是明確停止,Restart= 對它不生效。
#    ⚠️ 注意「連得上但不送資料」(卡在 await)**不會退出**,Restart= 管不到 ——
#      那是 deploy/check_feed_alive.sh 的守備範圍。
Restart=always
# 配合 Python 內 sleep(5)，形成穩健的重連冷卻
# 📌 與上面 StartLimit 的交互作用(2026-07-25 記):25s × 5 次 ≈ **100 秒內失敗 5 次就放棄**,
#    unit 進 failed 躺著。好處=不會猛敲登入觸發 451 Too Many Connections 鎖帳號;
#    代價=若 08:40 券商端故障超過約 2 分鐘,日盤整段沒資料(要等 14:55 crontab 再啟,
#    那時 600s 窗已過,start 會成功)。想讓短暫故障能熬過去就把這裡拉到 60s
#    (5 次攤在 5 分鐘內,crash loop 一樣擋得住)。目前刻意維持 25s。
RestartSec=25s

# --- 關閉行為 ---
# 確保 api.logout() 有足夠時間執行完成
KillSignal=SIGINT
TimeoutStopSec=30s

# --- 環境變數 ---
Environment=PYTHONUNBUFFERED=1
Environment=LC_ALL=C.UTF-8
Environment=LANG=C.UTF-8

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
