# txf-streaming-server 需要的環境變數(從 src/config.py 的 os.environ.get 實查而來)。
# 用法:cp .env.example .env,填入實際值。**.env 已 gitignore,絕不 commit。**

# --- Shioaji(永豐)API 憑證 ---
SHIOAJI_API_KEY=your_api_key_here
SHIOAJI_SECRET_KEY=your_secret_key_here

# --- Kafka ---
# ⚠️ 這是「本服務連到 broker」的位址,依部署位置而異:
#    生產機(broker 在同一台)= localhost:9092
#    開發鏡像(broker 在別台)= 192.168.1.50:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Topic 名稱 ---
# TICK_TOPIC    = 近月(TXFR1)逐筆
# TICK_R2_TOPIC = 次月(TXFR2)逐筆 —— 雙 topic 分流,viewer 的 basis / smart-rollover 依賴它
# BIDASK_TOPIC  = 委託簿
TICK_TOPIC=txf-tick
TICK_R2_TOPIC=txfr2-tick
BIDASK_TOPIC=txf-bidask
